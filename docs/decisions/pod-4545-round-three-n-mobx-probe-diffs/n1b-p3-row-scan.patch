  * slot (`list.tsx`) is the observer.
+ *
+ * PLANTED (P3 N1b): the row counts its children by walking the whole issue
+ * table through a context the list provides, over a local alias.
  */
 
-import { memo, type ReactElement } from 'react'
+import { observer } from 'mobx-react-lite'
+import { type ReactElement, useContext } from 'react'
 import type { RowProps } from '../../../../shared/src/row-shell'
+import { PoolContext } from './pool-context'
 
-export const PoolRow = memo(function PoolRow({ row }: RowProps): ReactElement {
+export const PoolRow = observer(function PoolRow({ row }: RowProps): ReactElement {
+  const pool = useContext(PoolContext)
+  // PLANTED (P3 N1b): one row's draw walks the corpus.
+  const table = pool === null ? undefined : pool.fenced.issue
+  let children = 0
+  if (table !== undefined) {
+    for (const issue of table.values()) {
+      if ((issue as { parentId?: string | null }).parentId === row.id) children += 1
+    }
+  }
   return (
     <div data-issue-row={row.id} data-selected={row.selected ? 'true' : 'false'}>
       {row.displayRef} {row.title} [{row.phase}
       {row.working ? '*' : ''}
       {row.asking ? '?' : ''}] {row.progressDone}/{row.progressTotal}
-      {row.originTick !== null ? ` ⤷${row.originTick.ref}` : ''}
