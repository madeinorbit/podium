+/**
+ * PLANTED (P3 N1b) — the pool to the row through a context. The module
+ * imports the pool type only, so the lint fence's syntactic rules do not see
+ * the store reach the component.
+ */
+
+import { createContext } from 'react'
+import type { MobxPool } from '../pool'
+
+export const PoolContext = createContext<MobxPool | null>(null)
