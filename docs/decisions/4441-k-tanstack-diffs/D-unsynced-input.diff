+/**
+ * K3-D (foot-gun, exercise only): an issue carrying a `snoozedUntil` wire
+ * field is hidden while coarseNow is before it. The predicate and the fold
+ * below are wired — but the issuesN select never carries the field, so the
+ * input the sync routing never writes into any collection reads undefined
+ * forever and the row never hides. Typecheck, parity and every arm test stay
+ * green: nothing declares that a carried input must arrive.
+ */
+export function snoozedUntilMs(issue: { snoozedUntil?: string | null }): number | null {
+  return parseMs(issue.snoozedUntil)
+}
+
+/** K3-D: hidden while the snooze timestamp lies in the future. */
+export function isSnoozed(issue: { snoozedUntil?: string | null }, now: number): boolean {
+  const until = snoozedUntilMs(issue)
+  return until !== null && until > now
+}
+
