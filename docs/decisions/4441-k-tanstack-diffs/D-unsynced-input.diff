+/**
+ * K3-D probe (KEPT in the diff as the firing evidence): a snoozed row must
+ * hide. On the foot-gun branch the input never reaches any collection, so the
+ * row stays visible and this test FAILS — while typecheck, fixture parity
+ * and every other arm test stay green. On the clean tree (or the fixed A
+ * branch) it passes.
+ */
+
+import { describe, expect, it } from 'vitest'
+import type { SliceIssue } from '../../shared/src/slice-types'
+import { issue, row, testWorld, workedExample, NOW } from './tanstack.test'
+
+const iso = (ms: number): string => new Date(ms).toISOString()
+
+describe('k3d omitted-input probe', () => {
+  it('a snoozed row hides until the passing tick', () => {
+    const world = testWorld(workedExample())
+    const before = world.store.entities.issues.collection.get('A') as SliceIssue
+    world.push({
+      type: 'update',
+      rows: [row('issue', 'A', { ...before, snoozedUntil: iso(NOW + 3600000) } as SliceIssue)],
+    })
+    // Intended: A hides while coarseNow is before snoozedUntil.
+    expect(world.store.snapshot().rowsById['A']).toBeUndefined()
+    world.store.setCoarseNow(NOW + 2 * 3600000)
+    expect(world.store.snapshot().rowsById['A']).toMatchObject({ id: 'A' })
+    world.store.dispose()
+  })
+})
