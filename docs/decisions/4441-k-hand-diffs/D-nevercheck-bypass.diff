diff --git a/packages/worklist-proto/arms/hand/k1d.scratch.test.ts b/packages/worklist-proto/arms/hand/k1d.scratch.test.ts
new file mode 100644
index 000000000..205c27876
--- /dev/null
+++ b/packages/worklist-proto/arms/hand/k1d.scratch.test.ts
@@ -0,0 +1,30 @@
+/** K1-D scratch: bypassed never-check — snoozed row never returns. */
+import { describe, expect, it } from 'vitest'
+import type { SliceIssue } from '../../shared/src/slice-types'
+import { issue, LANE, NOW, rec, session, testWorld, workingState } from './hand.test'
+
+const iso = (ms: number): string => new Date(ms).toISOString()
+
+describe('K1-D bypass', () => {
+  it('tick past the snooze leaves the row hidden; oracle fires', () => {
+    const world = testWorld([
+      rec('issue', 'Z', issue({ id: 'Z', seq: 5 })),
+      rec('issue', 'S', {
+        ...issue({ id: 'S', seq: 4 }),
+        snoozedUntil: iso(NOW + 60_000),
+      } as SliceIssue),
+      rec('session', 'sz', session({ sessionId: 'sz', issueId: 'Z', agentState: workingState })),
+      rec('session', 'ss', session({ sessionId: 'ss', issueId: 'S', agentState: workingState })),
+      rec('worktree', '/wt', LANE),
+    ])
+    // Hiding works (IssueChanged is still handled).
+    expect(world.store.snapshot().rowsById['S']).toBeUndefined()
+    world.oracle()
+    // The passing tick emits SnoozeChanged per carrier — ignored by the
+    // bypassed handler — so the row stays hidden although time has passed.
+    world.store.setCoarseNow(NOW + 120_000)
+    expect(world.store.snapshot().rowsById['S']).toBeUndefined()
+    // The rebuild oracle fires: from-scratch derivation shows the row.
+    expect(() => world.oracle()).toThrowError(/rebuild oracle: snapshot/)
+  })
+})
