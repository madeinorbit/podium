+/**
+ * K1-D snooze input (exercise only): hidden while a `snoozedUntil` wire
+ * field lies in the future. Defensive read — undeclared on SliceIssue.
+ */
+export function isSnoozed(issue: SliceIssue, now: number): boolean {
+  const raw = (issue as SliceIssue & { snoozedUntil?: string | null }).snoozedUntil
+  const until = parseMs(raw)
+  return until !== null && until > now
+}
