+/**
+ * K2-C2 worktree lane rows (exercise only): a second row kind in the same
+ * ordered list and groups — a worktree with sessions but no issue.
+ *
+ * One model per lane id, holding the borrowed worktree row behind
+ * `observable.ref`. Lane rows are display-only: no selection, no fold, no
+ * progress — phase/working/asking derive from the lane's resolved sessions
+ * and the row rides the commit exactly like an issue row (JSON-compared
+ * `lastRowJson` counting `rowsDerived`). Field inventions with no spec
+ * behind them, recorded not defended: displayRef `prefix ?? path tail`,
+ * title `repoName`, band 1, rank `createdAt ''` (sorts last in-band).
+ */
+
+import { computed, computedStruct, makeObservable, observableRef } from 'mobx'
+import type { SliceRow, SliceSession } from '../../../shared/src/slice-types'
+import { isSessionWorking, motionPhase, type RankInput } from '../rules'
+import type { MobXStore } from '../store'
+
+/** Row-id namespace: lane rows must never collide with issue ids. */
+export function laneRowId(path: string): string {
+  return `lane:${path}`
+}
+
+export class LaneModel {
+  /** Borrowed immutable stream object; replaced, never mutated. */
+  value: import('../../../shared/src/slice-types').SliceWorktree
+  /** Owning store (buckets, locals, stats). Never reassigned. */
+  readonly store: MobXStore
+  /** Last committed row JSON; rowsDerived counts committed rows only. */
+  private lastRowJson: string | null = null
+
+  constructor(store: MobXStore, value: import('../../../shared/src/slice-types').SliceWorktree) {
+    this.store = store
+    this.value = value
+    makeObservable<LaneModel, 'lastRowJson' | 'laneSessions'>(this, {
+      value: observableRef,
+      store: false,
+      lastRowJson: false,
+      visible: computed,
+      row: computedStruct,
+      rankKey: computedStruct,
+      isSelected: computed,
+      tick: computed,
+      laneSessions: false,
+      repoKey: false,
+    })
+  }
+
+  /** Lonely lanes only: sessions present, no live issue seated at the path. */
+  get visible(): boolean {
+    if (this.laneSessions().length === 0) return false
+    return (this.store.liveIssuesAt(this.value.path).length === 0)
+  }
+
+  /** Resolved (unbound) sessions owned by this lane path (spec §2 R3). */
+  laneSessions(): SliceSession[] {
+    return this.store.laneSessions(this.value.path)
+  }
+
+  /** Group key merges same-repo paths, same as issues (spec §3 R-GROUP). */
+  repoKey(): string {
+    return this.value.repoId ?? this.value.repoPath
+  }
+
+  get rankKey(): RankInput {
+    return { band: 1, sortKey: null, createdAt: '', seq: 0, id: laneRowId(this.value.path) }
+  }
+
+  /** Lanes are never selected (selection names issues; spec §3 R-SEL). */
+  get isSelected(): boolean {
+    return false
+  }
+
+  /** No origin tick on lanes. */
+  get tick(): null {
+    return null
+  }
+
+  /** The committed lane row; identity-stable while inputs settle. */
+  get row(): SliceRow | null {
+    if (!this.visible) {
+      if (this.lastRowJson !== null) {
+        this.lastRowJson = null
+        this.store.stats.rowsDerived += 1
+      }
+      return null
+    }
+    const t0 = performance.now()
+    try {
+      const sessions = this.laneSessions()
+      const kinds = sessions.map((s) => motionPhase(s))
+      let phase: SliceRow['phase']
+      if (kinds.includes('waiting')) phase = 'waiting'
+      else if (kinds.includes('working')) phase = 'working'
+      else if (kinds.length > 0 && kinds.every((k) => k === 'done')) phase = 'done'
+      else phase = 'queued'
+      const tail = this.value.path.split('/').pop() || this.value.path
+      const next: SliceRow = {
+        id: laneRowId(this.value.path),
+        displayRef: this.value.prefix ?? tail,
+        title: this.value.repoName,
+        phase,
+        progressDone: 0,
+        progressTotal: 0,
+        working: sessions.some((s) => isSessionWorking(s)),
+        asking: kinds.includes('waiting'),
+        band: 1,
+        repoKey: this.repoKey(),
+        closed: false,
+      }
+      const json = JSON.stringify(next)
+      if (json !== this.lastRowJson) {
+        this.lastRowJson = json
+        this.store.stats.rowsDerived += 1
+      }
+      return next
+    } finally {
+      this.store.addRowMs(performance.now() - t0)
+    }
+  }
+}
