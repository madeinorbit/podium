+// @vitest-environment happy-dom
+/**
+ * K2-D probe (kept in the diff as firing evidence): omitted bookkeeping in
+ * the MobX idiom — a new input in a plain module variable read by a getter.
+ * Run twice: enforcement ON (the arm's config) and OFF (control).
+ */
+import { configure } from 'mobx'
+import { describe, expect, it } from 'vitest'
+import { act } from 'react'
+import { createReplaySource, mountArmForCounts, runCountScenario } from '../../harness/src/count-harness'
+import type { SliceLocals } from '../../shared/src/slice-types'
+import { mobxArm } from './arm'
+import { issue, LANE, NOW, rec, session, workingState } from './mobx.test'
+import { setK2dSnoozeGate } from './models/issue'
+
+const iso = (ms: number): string => new Date(ms).toISOString()
+
+function mountGateWorld() {
+  const replay = createReplaySource({
+    issues: [
+      rec('issue', 'A', {
+        ...issue({ id: 'A', seq: 10, sortKey: 'a0', worktreePath: '/wt' }),
+        snoozedUntil: iso(NOW + 3600000),
+      } as never),
+    ],
+    sessions: [rec('session', 's1', session({ sessionId: 's1', issueId: 'A', agentState: workingState }))],
+    worktrees: [rec('worktree', '/wt', LANE)],
+  })
+  const locals: SliceLocals = { selectedIssueId: null, coarseNow: NOW }
+  const mounted = mountArmForCounts(mobxArm, replay.source, locals)
+  return { replay, mounted }
+}
+
+async function gateFlipStale(): Promise<{ visibleAfterFlip: string[] }> {
+  setK2dSnoozeGate(false)
+  const { mounted } = mountGateWorld()
+  try {
+    expect(Object.keys(mounted.handle.snapshot().rowsById)).toEqual(['A'])
+    await runCountScenario(mounted, {
+      scenario: 'gateFlip',
+      methodology: '#K2D',
+      apply: () => {
+        act(() => {
+          // Plain-variable flip: no observable moves, so no computed re-runs.
+          setK2dSnoozeGate(true)
+        })
+      },
+      expected: () => mounted.handle.snapshot(),
+    })
+    return { visibleAfterFlip: Object.keys(mounted.handle.snapshot().rowsById).sort() }
+  } finally {
+    mounted.unmount()
+    setK2dSnoozeGate(false)
+  }
+}
+
+describe('K2-D plain-variable gate', () => {
+  it('enforcement ON: flipped gate leaves a stale visible row', async () => {
+    const { visibleAfterFlip } = await gateFlipStale()
+    console.info(`[k2d-ON] visible after flip=${JSON.stringify(visibleAfterFlip)} (intended: [])`)
+    // The row SHOULD hide (gate on + future snooze) but stays: stale screen.
+    expect(visibleAfterFlip).toEqual([])
+  })
+
+  it('enforcement OFF (control): same staleness, no check fires either', async () => {
+    configure({ enforceActions: 'never', computedRequiresReaction: false, observableRequiresReaction: false, reactionRequiresObservable: false })
+    try {
+      const { visibleAfterFlip } = await gateFlipStale()
+      console.info(`[k2d-OFF] visible after flip=${JSON.stringify(visibleAfterFlip)} (intended: [])`)
+      expect(visibleAfterFlip).toEqual([])
+    } finally {
+      configure({ enforceActions: 'always', computedRequiresReaction: true, observableRequiresReaction: true, reactionRequiresObservable: true })
+    }
+  })
+})
