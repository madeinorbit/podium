+        readAtOnline,
+        readAtWhileOffline,
+        readAtAfterDrain: null,
+        outboxKeys,
+        drainedToDatabase: true,
+        pageErrors,
+      },
+      null,
+      2,
+    ),
+  )
+} finally {
+  await browser.close()
+  daemon.kill('SIGTERM')
+  await daemon.exited.catch(() => undefined)
+  await stopServer(server).catch(() => undefined)
+}
+console.log('offline-edit-drains complete')
