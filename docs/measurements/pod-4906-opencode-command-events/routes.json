    }
  },
  "/command": {
    "get": {
      "tags": [
        "instance"
      ],
      "operationId": "command.list",
      "parameters": [
        {
          "name": "directory",
          "in": "query",
          "schema": {
            "type": "string"
          },
          "required": false
        },
        {
          "name": "workspace",
          "in": "query",
          "schema": {
            "type": "string"
          },
