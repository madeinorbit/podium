{
  "$schema": "https://turbo.build/schema.json",
  "daemon": false,
  "globalDependencies": ["tooling/tsconfig/**", "package.json", "bun.lock"],
  "globalEnv": ["PODIUM_CHECK_ENV_HASH"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "@podium/model#typecheck": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    }
  }
}
