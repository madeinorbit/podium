{
  "$schema": "https://turbo.build/schema.json",
  "daemon": false,
  "globalDependencies": [
    "tooling/tsconfig/**",
    "package.json",
    "bun.lock",
    "vitest.config.ts",
    "vitest.unit.config.ts",
    "vitest.smoke-requirements.ts",
    "test-hermetic-*.ts",
    "scripts/package-vitest-config.ts"
