{
  "$schema": "https://turbo.build/schema.json",
  "daemon": false,
  "globalDependencies": ["tooling/tsconfig/**", "package.json", "bun.lock"],
  "globalEnv": ["PODIUM_CHECK_ENV_HASH"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "@podium/model#typecheck": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "@podium/web#test": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/apps/daemon/src/**"
      ],
      "outputs": []
    },
    "@podium/mobile#test": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/*/src/**"],
      "outputs": []
    }
  }
}
