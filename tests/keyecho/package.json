{
  "name": "@podium/keyecho",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Keyboard/mouse echo test jig: a fake agent CLI that reflects every input byte it receives, for verifying keystroke fidelity through Podium's PTY pipeline.",
  "exports": {
    ".": {
      "@podium/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "start": "tsx src/cli.tsx",
    "typecheck": "bun ../../scripts/validation-admission.ts typecheck --label @podium/keyecho:typecheck -- tsgo --noEmit",
    "typecheck:tsc": "bun ../../scripts/validation-admission.ts typecheck --label @podium/keyecho:typecheck:tsc -- tsc --noEmit",
    "test": "bun ../../scripts/validation-admission.ts focused --label @podium/keyecho:test -- bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "ink": "^6.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@podium/pty": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "5.0.0-beta.6"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  }
}
