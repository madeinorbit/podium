{
  "name": "@podium/worklist-tests",
  "version": "0.0.0",
  "private": true,
  "description": "Private pool test support: reference state, fixtures, scenarios and work meters. No product entry imports this workspace.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "typecheck": "bun ../../scripts/typecheck-project.ts",
    "test": "bun ../../scripts/validation-admission.ts focused --label @podium/worklist-tests:test -- bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts --passWithNoTests"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "@babel/core": "7.29.0",
    "@babel/eslint-parser": "7.29.9",
    "@babel/plugin-syntax-typescript": "7.27.1",
    "@podium/client-core": "workspace:*",
    "@podium/model": "workspace:*",
    "@podium/sync": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "eslint": "9.39.2",
    "happy-dom": "^20.10.2",
    "react": "19.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "5.0.0-beta.6",
    "@podium/runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "dependencies": {
    "mobx": "7.0.3",
    "mobx-react-lite": "5.0.3",
    "@podium/client-graph": "workspace:*",
    "@podium/protocol": "workspace:*",
    "@podium/mobx-helpers": "workspace:*"
  }
}
