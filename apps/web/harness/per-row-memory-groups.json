{
  "pool: all machinery": {
    "handles": [
      "pool",
      "pool.*"
    ],
    "mobx": true,
    "scripts": "^(hand-pool|lean-pool)-"
  },
  "pool: per-row model computeds (cached.ts)": {
    "sites": "^ComputedValue (IssueModel|SessionModel|WorktreeModel|RepoModel)@"
  },
  "pool: boxed map entries (ObservableMap values)": {
    "sites": "^ObservableValue ObservableMap\\.key($| )"
  },
  "pool: tracked has() entries (ObservableMap hasMap_)": {
    "sites": "^ObservableValue ObservableMap\\.key\\?"
  },
  "pool: per-issue file reactions (visible.ts)": {
    "sites": "^Reaction pool\\.file\\."
  },
  "pool: relation engine and buckets": {
    "handles": [
      "pool.engine",
      "pool.relations"
    ]
  },
  "pool: residency": {
    "handles": [
      "pool.residency"
    ]
  },
  "pool: sidebar indexes and groups": {
    "handles": [
      "pool.sidebarRosters",
      "pool.groups",
      "pool.worklist",
      "pool.sidebar"
    ]
  },
  "pool: read-state lane": {
    "handles": [
      "pool.readStates"
    ]
  },
  "pool: MobX debug names": {
    "sites": "^\\(MobX debug names\\)$"
  },
  "legacy store (published snapshot, engine state and base arrays, view-model cache)": {
    "handles": [
      "snapshot",
      "snapshot.*",
      "runtime.state",
      "runtime.subStore",
      "runtime.base*"
    ],
    "weakValuesOf": [
      "replica"
    ],
    "contextVars": [
      "lastMissionIndexIssues",
      "lastMissionIndex"
    ],
    "props": [
      [
        "displayRef",
        "sessionSummary",
        "memberSessionIds"
      ],
      [
        "displayRef",
        "memberSessionIds",
        "!title"
      ],
      [
        "prefix",
        "parentId",
        "stage",
        "!title"
      ]
    ]
  },
  "temporary old-record join (temporary-issue-input.ts)": {
    "props": [
      [
        "sessionFacts",
        "humanQuestionAskedBy",
        "repoPath",
        "readAt"
      ]
    ]
  },
  "kernel replica and its cache": {
    "handles": [
      "replica",
      "replica.*",
      "cache",
      "cache.*",
      "runtime.replica"
    ]
  },
  "old issue record (POD-4949 retires it)": {
    "props": [
      [
        "childDoneCount",
        "unread",
        "sessionSummary",
        "!displayRef"
      ]
    ]
  },
  "end state A: legacy store removed": {
    "handles": [
      "snapshot",
      "snapshot.*",
      "runtime.state",
      "runtime.subStore",
      "runtime.base*"
    ],
    "weakValuesOf": [
      "replica"
    ],
    "contextVars": [
      "lastMissionIndexIssues",
      "lastMissionIndex"
    ],
    "props": [
      [
        "displayRef",
        "sessionSummary",
        "memberSessionIds"
      ],
      [
        "displayRef",
        "memberSessionIds",
        "!title"
      ],
      [
        "prefix",
        "parentId",
        "stage",
        "!title"
      ]
    ]
  },
  "end state B: legacy store, temporary join and old issue record removed (POD-4949)": {
    "handles": [
      "snapshot",
      "snapshot.*",
      "runtime.state",
      "runtime.subStore",
      "runtime.base*"
    ],
    "mobx": false,
    "props": [
      [
        "displayRef",
        "sessionSummary",
        "memberSessionIds"
      ],
      [
        "displayRef",
        "memberSessionIds",
        "!title"
      ],
      [
        "prefix",
        "parentId",
        "stage",
        "!title"
      ],
      [
        "sessionFacts",
        "humanQuestionAskedBy",
        "repoPath",
        "readAt"
      ],
      [
        "childDoneCount",
        "unread",
        "sessionSummary",
        "!displayRef"
      ]
    ],
    "weakValuesOf": [
      "replica"
    ],
    "contextVars": [
      "lastMissionIndexIssues",
      "lastMissionIndex"
    ]
  },
  "prototype: pool and feed": {
    "handles": [
      "pool",
      "pool.*",
      "prototype.feed",
      "prototype.feed.*",
      "prototype.locals",
      "prototype.locals.*"
    ],
    "mobx": true,
    "scripts": "^(hand-pool|lean-pool|prototype-feed)-"
  },
  "prototype: MobX bookkeeping": {
    "mobx": true
  },
  "prototype: plain tables": {
    "handles": [
      "pool.tables",
      "pool.fenced"
    ]
  },
  "prototype: resident relations": {
    "handles": [
      "pool.engine",
      "pool.relations"
    ]
  },
  "prototype: feed adapter": {
    "handles": [
      "prototype.feed",
      "prototype.feed.*",
      "prototype.locals",
      "prototype.locals.*"
    ],
    "scripts": "^prototype-feed-"
  }
}
