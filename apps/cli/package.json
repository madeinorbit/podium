{
  "name": "@podium/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The `podium` CLI: mode-driven launcher (setup, lifecycle, systemd persistence, self-update) plus the `podium issue` and `podium worktree` subcommands. Host modules (server/daemon in-process hosting) are injected by the runnable entry in scripts/cli.ts \u2014 this package imports only leaf packages and the issue-client seam.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/cli.ts",
      "import": "./src/cli.ts"
    }
  },
  "scripts": {
    "typecheck": "bun ../../scripts/validation-admission.ts typecheck --label @podium/cli:typecheck -- tsgo --noEmit",
    "typecheck:tsc": "bun ../../scripts/validation-admission.ts typecheck --label @podium/cli:typecheck:tsc -- tsc --noEmit",
    "test": "bun ../../scripts/validation-admission.ts focused --label @podium/cli:test -- bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@podium/model": "workspace:*",
    "@podium/issue-client": "workspace:*",
    "@podium/protocol": "workspace:*",
    "@podium/runtime": "workspace:*",
    "@podium/telemetry": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
