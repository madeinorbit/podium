{
  "expo": {
    "name": "Podium",
    "slug": "podium-mobile",
    "version": "1.0.0",
    "scheme": "podium",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16171a"
    },
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "experiments": {
      "baseUrl": "/mobile"
    },
    "ios": {
      "bundleIdentifier": "dev.podium.mobile",
      "appleTeamId": "Z5A2ZC8STN",
      "buildNumber": "12",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Scan a one-time code to connect this phone to your Podium server.",
        "NSMicrophoneUsageDescription": "Dictate prompts privately using Apple's on-device speech model.",
        "NSLocalNetworkUsageDescription": "Connect to a Podium server you run on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "dev.podium.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#16171a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA"]
    },
    "androidStatusBar": {
      "backgroundColor": "#16171a",
      "barStyle": "light-content",
      "translucent": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#16171a",
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Podium"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf",
              "@expo-google-fonts/geist/600SemiBold/Geist_600SemiBold.ttf",
              "@expo-google-fonts/geist-mono/400Regular/GeistMono_400Regular.ttf",
              "@expo-google-fonts/geist-mono/600SemiBold/GeistMono_600SemiBold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Geist_400Regular",
                "fontDefinitions": [
                  {
                    "path": "@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Geist_600SemiBold",
                "fontDefinitions": [
                  {
                    "path": "@expo-google-fonts/geist/600SemiBold/Geist_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "GeistMono_400Regular",
                "fontDefinitions": [
                  {
                    "path": "@expo-google-fonts/geist-mono/400Regular/GeistMono_400Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "GeistMono_600SemiBold",
                "fontDefinitions": [
                  {
                    "path": "@expo-google-fonts/geist-mono/600SemiBold/GeistMono_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a one-time code to connect this phone to your Podium server.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "./plugins/with-sqlite-header-link"
    ]
  }
}
