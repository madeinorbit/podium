{
  "expo": {
    "name": "Podium Mobile",
    "slug": "podium-mobile",
    "version": "1.0.0",
    "scheme": "podium",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16171a"
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "experiments": {
      "baseUrl": "/mobile"
    },
    "ios": {
      "bundleIdentifier": "dev.podium.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan a one-time code to connect this phone to your Podium server.",
        "NSLocalNetworkUsageDescription": "Connect to a Podium server you run on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "dev.podium.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#16171a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA"]
    },
    "androidStatusBar": {
      "backgroundColor": "#16171a",
      "barStyle": "light-content",
      "translucent": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#16171a",
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Podium"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a one-time code to connect this phone to your Podium server.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ]
  }
}
