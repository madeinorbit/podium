{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "Bundler",
    "customConditions": ["@podium/source"],
    "types": ["node", "chai", "react", "react-dom"],
    "moduleSuffixes": [".web", ".native", ""],
    "preserveSymlinks": true,
    "skipLibCheck": true,
    "incremental": true
  },
  "include": ["app", "src"]
}
