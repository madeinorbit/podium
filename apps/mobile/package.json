    "@podium/protocol": "workspace:*",
    "@podium/sync": "workspace:*",
    "@podium/terminal-client": "workspace:*",
    "@podium/terminal-client-react": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native/virtualized-lists": "0.86.0",
    "@trpc/client": "^11.18.0",
    "expo": "~57.0.17",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-modules-core": "^57.0.14",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
