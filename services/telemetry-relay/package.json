{
  "name": "@podium/telemetry-relay",
  "version": "0.0.0",
  "private": true,
  "description": "The Podium-operated telemetry relay: validate against the published schema, drop the source IP, forward to PostHog [spec:SP-f933].",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "bun ../../scripts/validation-admission.ts typecheck --label @podium/telemetry-relay:typecheck -- tsc --noEmit",
    "test": "bun ../../scripts/validation-admission.ts focused --label @podium/telemetry-relay:test -- bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts --passWithNoTests",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@podium/telemetry": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
