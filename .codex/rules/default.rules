# Codex execpolicy (POD-3890). Declarative twin of scripts/agent-command-guard.ts:
# the compiler and the test runners are reached only through the repository wrappers.
prefix_rule(pattern=["tsc"], decision="forbidden", justification="Typecheck and tests run only through the repository wrappers: `bun run typecheck [-- --filter <package>]`, `bun run test`, `bun run test:file -- <files>`, `bun run test:lane -- <lane>`; see docs/agents/testing.md")
