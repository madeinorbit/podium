diff --git a/React/Tests/Text/RCTParagraphComponentViewTests.mm b/React/Tests/Text/RCTParagraphComponentViewTests.mm
--- a/React/Tests/Text/RCTParagraphComponentViewTests.mm
+++ b/React/Tests/Text/RCTParagraphComponentViewTests.mm
@@ -470,4 +470,70 @@
   XCTAssertTrue(elements[0].accessibilityTraits & UIAccessibilityTraitLink);
 }

+- (void)testCachedInlineSemanticColorsFollowAppearanceWithoutChangingMeasurement
+{
+  RCTTextLayoutManager *manager = [RCTTextLayoutManager new];
+  AttributedString string;
+  auto attributes = TextAttributes::defaultTextAttributes();
+  attributes.fontSize = 24;
+  attributes.foregroundColor = SharedColor{Color{DynamicColor{
+      .lightColor = static_cast<int32_t>(0xFFFF0000),
+      .darkColor = static_cast<int32_t>(0xFF0000FF)}}};
+  AttributedString::Fragment count;
+  count.string = "41/64";
+  count.textAttributes = attributes;
+  string.appendFragment(count);
+  AttributedString::Fragment next;
+  next.string = "  11 up next";
+  next.textAttributes = attributes;
+  next.textAttributes.foregroundColor = colorFromRGBA(0, 128, 0, 255);
+  string.appendFragment(next);
+  ParagraphAttributes paragraph;
+  TextLayoutContext context;
+  LayoutConstraints constraints{.maximumSize = {.width = 300, .height = 100}};
+
+  // Warm the same native measurement cache under the opposite appearance.
+  __block TextMeasurement measured;
+  [[UITraitCollection traitCollectionWithUserInterfaceStyle:UIUserInterfaceStyleDark] performAsCurrentTraitCollection:^{
+    measured = [manager measureAttributedString:string
+                           paragraphAttributes:paragraph
+                                 layoutContext:context
+                             layoutConstraints:constraints];
+  }];
+  for (UIUserInterfaceStyle style : {UIUserInterfaceStyleLight, UIUserInterfaceStyleDark, UIUserInterfaceStyleLight}) {
+    unsigned char pixels[300 * 100 * 4] = {};
+    CGColorSpaceRef space = CGColorSpaceCreateDeviceRGB();
+    CGContextRef bitmap = CGBitmapContextCreate(pixels, 300, 100, 8, 300 * 4, space,
+        kCGImageAlphaPremultipliedLast | kCGBitmapByteOrder32Big);
+    CGColorSpaceRelease(space);
+    XCTAssertNotEqual(bitmap, nullptr);
+    UIGraphicsPushContext(bitmap);
+    [[UITraitCollection traitCollectionWithUserInterfaceStyle:style] performAsCurrentTraitCollection:^{
+      [manager drawAttributedString:string paragraphAttributes:paragraph
+                             frame:CGRectMake(0, 0, 300, 100) drawHighlightPath:nil];
+      auto again = [manager measureAttributedString:string
+                               paragraphAttributes:paragraph
+                                     layoutContext:context
+                                 layoutConstraints:constraints];
+      XCTAssertEqual(again.size.width, measured.size.width);
+      XCTAssertEqual(again.size.height, measured.size.height);
+    }];
+    UIGraphicsPopContext();
+    CGContextRelease(bitmap);
+    NSUInteger red = 0;
+    NSUInteger blue = 0;
+    for (NSUInteger i = 0; i < sizeof(pixels); i += 4) {
+      if (pixels[i] > 64 && pixels[i] > pixels[i + 2] + 32) red++;
+      if (pixels[i + 2] > 64 && pixels[i + 2] > pixels[i] + 32) blue++;
+    }
+    if (style == UIUserInterfaceStyleLight) {
+      XCTAssertGreaterThan(red, 10U);
+      XCTAssertEqual(blue, 0U);
+    } else {
+      XCTAssertGreaterThan(blue, 10U);
+      XCTAssertEqual(red, 0U);
+    }
+  }
+}
+
 @end
