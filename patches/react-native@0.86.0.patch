diff --git a/ReactCommon/react/renderer/components/root/tests/RootShadowNodeTest.cpp b/ReactCommon/react/renderer/components/root/tests/RootShadowNodeTest.cpp
--- a/ReactCommon/react/renderer/components/root/tests/RootShadowNodeTest.cpp
+++ b/ReactCommon/react/renderer/components/root/tests/RootShadowNodeTest.cpp
@@ -43,4 +43,34 @@
   EXPECT_TRUE(clonedWithDifferentLayoutConstraints->layoutIfNeeded());
 }

+TEST(RootShadowNodeTest, cloneWithFontSizeMultiplier) {
+  ContextContainer contextContainer{};
+  PropsParserContext parserContext{-1, contextContainer};
+  auto builder = simpleComponentBuilder();
+  std::shared_ptr<RootShadowNode> root;
+  auto element = Element<RootShadowNode>().reference(root).tag(1);
+  builder.build(element);
+  root->layoutIfNeeded();
+  root->sealRecursive();
+
+  // A font-only update must not hit the clean-root early return. The
+  // surface already invalidates the measured descendants before commit.
+  for (auto multiplier : {3.571f, 0.823f}) {
+    auto context = root->getConcreteProps().layoutContext;
+    context.fontSizeMultiplier = multiplier;
+    auto changed = root->clone(
+        parserContext, root->getConcreteProps().layoutConstraints, context);
+    EXPECT_FALSE(changed->getIsLayoutClean());
+    EXPECT_TRUE(changed->layoutIfNeeded());
+    EXPECT_TRUE(changed->getIsLayoutClean());
+    EXPECT_TRUE(root->getIsLayoutClean());
+    EXPECT_EQ(changed->getFamilyShared(), root->getFamilyShared());
+  }
+
+  auto unchanged = root->clone(
+      parserContext, root->getConcreteProps().layoutConstraints,
+      root->getConcreteProps().layoutContext);
+  EXPECT_FALSE(unchanged->layoutIfNeeded());
+}
+
 } // namespace facebook::react
