+- (CGFloat)rnscreens_scrollToTopInsetForScrollView:(UIScrollView *)scrollView
+{
+  CGFloat topInset = scrollView.adjustedContentInset.top;
+  UINavigationItem *navigationItem = self.topViewController.navigationItem;
+  if (self.viewControllers.count != 1 || self.isNavigationBarHidden || !self.navigationBar.prefersLargeTitles ||
+      navigationItem.largeTitleDisplayMode == UINavigationItemLargeTitleDisplayModeNever) {
+    return topInset;
+  }
+
+  // UIKit reduces adjustedContentInset along with a collapsed large title. Remember
+  // the expanded bar during layout, before a re-tap needs to restore that height.
+  // Reset measurements when the root, orientation or Dynamic Type size changes.
+  CGFloat layoutWidth = self.view.bounds.size.width;
+  UIContentSizeCategory contentSizeCategory = self.traitCollection.preferredContentSizeCategory;
+  if (_scrollToTopNavigationItem != navigationItem || _scrollToTopLayoutWidth != layoutWidth ||
+      ![_scrollToTopContentSizeCategory isEqualToString:contentSizeCategory] ||
+      _scrollToTopVerticalSizeClass != self.traitCollection.verticalSizeClass) {
+    _scrollToTopNavigationItem = navigationItem;
+    _scrollToTopLayoutWidth = layoutWidth;
+    _scrollToTopContentSizeCategory = contentSizeCategory;
+    _scrollToTopVerticalSizeClass = self.traitCollection.verticalSizeClass;
+    _scrollToTopExpandedBarHeight = 0;
+  }
+
+  CGFloat barHeight = self.navigationBar.bounds.size.height;
+  if (!scrollView.isDragging && !scrollView.isDecelerating) {
+    _scrollToTopExpandedBarHeight = MAX(_scrollToTopExpandedBarHeight, barHeight);
+  }
+
+  // Use today's safe area and content inset; only the measured title delta is cached.
+  return topInset + MAX(0, _scrollToTopExpandedBarHeight - barHeight);
