+@interface RNSNavigationController ()
+- (void)rnscreens_refreshHeaderColorAppearance;
+@end
+
 @implementation RNSNavigationController {
+  UITraitCollection *_lastVisibleHeaderTraits;
+  BOOL _headerAppearanceVisible;
+  BOOL _headerAppearanceNeedsRefresh;
 #if !TARGET_OS_TV
   __weak UINavigationItem *_scrollToTopNavigationItem;
   CGFloat _scrollToTopLayoutWidth;
@@ -46,6 +53,60 @@
   UIUserInterfaceSizeClass _scrollToTopVerticalSizeClass;
   CGFloat _scrollToTopExpandedBarHeight;
 #endif
+}
+
+// A tab can hide/show this controller without changing its top screen, so
+// UINavigationController's willShow delegate does not reapply that header.
+- (void)viewWillAppear:(BOOL)animated
+{
+  [super viewWillAppear:animated];
+  UITraitCollection *traits = self.traitCollection;
+  BOOL colorsChanged = _lastVisibleHeaderTraits != nil &&
+      [traits hasDifferentColorAppearanceComparedToTraitCollection:_lastVisibleHeaderTraits];
+  _headerAppearanceVisible = YES;
+  if (_headerAppearanceNeedsRefresh || colorsChanged) {
+    [traits performAsCurrentTraitCollection:^{
+      [self rnscreens_refreshHeaderColorAppearance];
+    }];
+  }
+  _headerAppearanceNeedsRefresh = NO;
+  _lastVisibleHeaderTraits = traits;
+}
+
+- (void)viewWillDisappear:(BOOL)animated
+{
+  _lastVisibleHeaderTraits = self.traitCollection;
+  _headerAppearanceVisible = NO;
+  [super viewWillDisappear:animated];
+}
+
+- (void)traitCollectionDidChange:(UITraitCollection *)previousTraitCollection
+{
+  [super traitCollectionDidChange:previousTraitCollection];
+  if (_lastVisibleHeaderTraits == nil ||
+      ![self.traitCollection hasDifferentColorAppearanceComparedToTraitCollection:previousTraitCollection]) {
+    return;
+  }
+  if (_headerAppearanceVisible) {
+    // UIKit updates visible glass itself. Keep its applied traits current.
+    _lastVisibleHeaderTraits = self.traitCollection;
+  } else {
+    // Keep this latched even if another hidden switch restores the old style.
+    _headerAppearanceNeedsRefresh = YES;
+  }
+}
+
+- (void)rnscreens_refreshHeaderColorAppearance
+{
+  UIViewController *screen = self.topViewController;
+  if (![screen.view isKindOfClass:RNSScreenView.class]) {
+    return;
+  }
+  RNSScreenStackHeaderConfig *config = ((RNSScreenView *)screen.view).findHeaderConfig;
+  if (config != nil) {
+    [RNSScreenStackHeaderConfig willShowViewController:screen animated:NO withConfig:config];
+    [self.navigationBar setNeedsLayout];
+  }
 }

