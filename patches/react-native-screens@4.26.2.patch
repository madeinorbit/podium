diff --git a/tests/ios/RNSNavigationControllerAppearanceTests.mm b/tests/ios/RNSNavigationControllerAppearanceTests.mm
new file mode 100644
--- /dev/null
+++ b/tests/ios/RNSNavigationControllerAppearanceTests.mm
@@ -0,0 +1,142 @@
+#import <XCTest/XCTest.h>
+#import "../../ios/RNSScreenStack.h"
+
+// Add this fixture to an app-hosted iOS XCTest target linked with RNScreens.
+// It exercises the production visibility/trait lifecycle; material rendering
+// still needs the hidden-tab simulator regression.
+@interface RNSNavigationController (AppearanceTests)
+- (void)rnscreens_refreshHeaderColorAppearance;
+@end
+
+@interface HeaderAppearanceNavigationController : RNSNavigationController
+@property (nonatomic, strong) UITraitCollection *testTraits;
+@property (nonatomic, strong) UITraitCollection *reappliedTraits;
+@property (nonatomic) NSUInteger refreshCount;
+@end
+
+@implementation HeaderAppearanceNavigationController
+- (UITraitCollection *)traitCollection
+{
+  return self.testTraits ?: [super traitCollection];
+}
+
+- (void)rnscreens_refreshHeaderColorAppearance
+{
+  self.refreshCount++;
+  self.reappliedTraits = UITraitCollection.currentTraitCollection;
+}
+@end
+
+@interface RNSNavigationControllerAppearanceTests : XCTestCase
+@property (nonatomic, strong) HeaderAppearanceNavigationController *navigation;
+@end
+
+@implementation RNSNavigationControllerAppearanceTests
+- (void)setUp
+{
+  [super setUp];
+  self.navigation = [[HeaderAppearanceNavigationController alloc]
+      initWithRootViewController:[UIViewController new]];
+  self.navigation.testTraits = [UITraitCollection traitCollectionWithUserInterfaceStyle:UIUserInterfaceStyleDark];
+  [self.navigation loadViewIfNeeded];
+}
+
+- (void)show
+{
+  [self.navigation beginAppearanceTransition:YES animated:NO];
+  [self.navigation endAppearanceTransition];
+}
+
+- (void)hide
+{
+  [self.navigation beginAppearanceTransition:NO animated:NO];
+  [self.navigation endAppearanceTransition];
+}
+
+- (void)changeTraits:(UITraitCollection *)traits
+{
+  UITraitCollection *previous = self.navigation.testTraits;
+  self.navigation.testTraits = traits;
+  [self.navigation traitCollectionDidChange:previous];
+}
+
+- (void)testColdAndUnchangedAppearancesDoNotRebuildHeader
+{
+  [self changeTraits:[UITraitCollection traitCollectionWithUserInterfaceStyle:UIUserInterfaceStyleLight]];
+  [self show];
+  [self hide];
+  [self show];
+  XCTAssertEqual(self.navigation.refreshCount, 0U);
+}
+
+- (void)testHiddenAppearanceReappliesOnceWithCurrentTraitsAndSameScreen
+{
+  [self show];
+  UIViewController *screen = self.navigation.topViewController;
+  UINavigationBar *bar = self.navigation.navigationBar;
+  [self hide];
+  [self changeTraits:[UITraitCollection traitCollectionWithUserInterfaceStyle:UIUserInterfaceStyleLight]];
+  XCTAssertEqual(self.navigation.refreshCount, 0U);
+  [self show];
+  XCTAssertEqual(self.navigation.refreshCount, 1U);
+  XCTAssertEqual(self.navigation.reappliedTraits.userInterfaceStyle, UIUserInterfaceStyleLight);
+  XCTAssertEqual(self.navigation.topViewController, screen);
+  XCTAssertEqual(self.navigation.navigationBar, bar);
+  [self hide];
+  [self show];
+  XCTAssertEqual(self.navigation.refreshCount, 1U);
+}
+
+- (void)testVisibleAppearanceAlreadyUpdatedByUIKitNeedsNoFocusRebuild
+{
+  [self show];
+  [self changeTraits:[UITraitCollection traitCollectionWithUserInterfaceStyle:UIUserInterfaceStyleLight]];
+  [self hide];
+  [self show];
+  XCTAssertEqual(self.navigation.refreshCount, 0U);
+}
+
+- (void)testHiddenRoundTripRemainsDirtyEvenWhenFinalStyleMatches
+{
+  [self show];
+  [self hide];
+  [self changeTraits:[UITraitCollection traitCollectionWithUserInterfaceStyle:UIUserInterfaceStyleLight]];
+  [self changeTraits:[UITraitCollection traitCollectionWithUserInterfaceStyle:UIUserInterfaceStyleDark]];
+  [self show];
+  XCTAssertEqual(self.navigation.refreshCount, 1U);
+  XCTAssertEqual(self.navigation.reappliedTraits.userInterfaceStyle, UIUserInterfaceStyleDark);
+}
+
+- (void)testDeferredTraitDeliveryIsDetectedOnAppearance
+{
+  [self show];
+  [self hide];
+  self.navigation.testTraits = [UITraitCollection traitCollectionWithUserInterfaceStyle:UIUserInterfaceStyleLight];
+  [self show];
+  XCTAssertEqual(self.navigation.refreshCount, 1U);
+}
+
+- (void)testHiddenContrastChangeAlsoRefreshes
+{
+  [self show];
+  [self hide];
+  [self changeTraits:[UITraitCollection traitCollectionWithTraitsFromCollections:@[
+    [UITraitCollection traitCollectionWithUserInterfaceStyle:UIUserInterfaceStyleDark],
+    [UITraitCollection traitCollectionWithAccessibilityContrast:UIAccessibilityContrastHigh]
+  ]]];
+  [self show];
+  XCTAssertEqual(self.navigation.refreshCount, 1U);
+  XCTAssertEqual(self.navigation.reappliedTraits.accessibilityContrast, UIAccessibilityContrastHigh);
+}
+
+- (void)testCancelledWillDisappearWithoutTraitChangeDoesNotRebuild
+{
+  [self show];
+  UIViewController *screen = self.navigation.topViewController;
+  [self.navigation viewWillDisappear:YES];
+  [self.navigation viewWillAppear:YES];
+  [self.navigation viewDidAppear:YES];
+  XCTAssertEqual(self.navigation.refreshCount, 0U);
+  XCTAssertEqual(self.navigation.topViewController, screen);
+}
+@end
