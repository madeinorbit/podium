node_modules/
dist/
# Retained source maps for the last 10 web builds (POD-1957) — build output that
# deliberately outlives `dist`, so a crash report stays resolvable across rebuilds.
.sourcemaps/
coverage/
*.tsbuildinfo
*.log
.DS_Store
.env
.env.*
!.env.example
.turbo/

# Playwright
tests/e2e/test-results/
tests/e2e/playwright-report/
/e2e/

# Brainstorming visual companion
.superpowers/

# Agent harness session state + nested worktrees (not part of this repo's lint/test scope).
# Ignored as a whole directory, not `.claude/*`: grok's file watcher only tests the repo's
# immediate children against .gitignore, then watches each survivor recursively. `.claude/*`
# leaves `.claude` itself unignored, so grok walked into .claude/worktrees and took ~150K
# inotify watches per session (issue #226). `.claude/settings.json` stays tracked because
# ignore rules never apply to files already in the index; adding new ones needs `git add -f`.
.claude/
.claire/
.worktrees/
test-results/

# bun build --compile artifacts
dist-bun/
dist-bun-spike/

# POD-2501 spike: Mach-O abduco payloads (rebuild via scripts/spike/build-prebuilt-abduco.sh)
scripts/prebuilt/abduco/darwin-arm64/
scripts/prebuilt/abduco/darwin-x64/

# Headless self-update DEV signing key (private half; pubkey is committed). Never commit.
scripts/.podium-update-dev.key
# Headless update artifacts produced by build-bun.ts
podium-headless-*.tar.gz
podium-headless-*.tar.gz.sig

# Local profiling/diagnostic clutter
report.*.json
mon.pid

# Agent-local test tempdirs (never commit)
.tmp-claude/

# One-off runtime-verification screenshot dumps
verify-artifacts/

# Issue review artifacts are attached through Podium, not committed to the repository
.artifacts/

# Scratch output for perf:typing and similar one-off benchmarks
.tmp/

# Patch/merge debris. Two workers in one day left .orig files staged for commit
# because `git add -A` picks them up; they are never wanted in the tree.
*.orig
*.rej
