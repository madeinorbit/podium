{
  "name": "@podium/pty",
  "version": "0.0.0",
  "private": true,
  "description": "Harness-agnostic PTY kernel: swappable PTY backends (Bun.Terminal / node-pty), durable session hosts (abduco, tmux, systemd scopes) with the vendored abduco build, byte framing, OSC title scan and redraw.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@podium/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "vendor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@podium/model": "workspace:*",
    "@podium/protocol": "workspace:*",
    "@podium/runtime": "workspace:*"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "test": "vitest run --root ../.. --config vitest.unit.config.ts --project node packages/pty/src --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
