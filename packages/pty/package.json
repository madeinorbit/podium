{
  "name": "@podium/process",
  "version": "0.0.0",
  "private": true,
  "description": "Harness-agnostic process kernel with raw PTY backends, durable session hosts (abduco, systemd scopes), byte framing, OSC title scan and redraw.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@podium/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pty": {
      "@podium/source": "./src/pty.ts",
      "types": "./dist/pty.d.ts",
      "import": "./dist/pty.js"
    },
    "./durable": {
      "@podium/source": "./src/durable.ts",
      "types": "./dist/durable.d.ts",
      "import": "./dist/durable.js"
    },
    "./screen": {
      "@podium/source": "./src/screen.ts",
      "types": "./dist/screen.d.ts",
      "import": "./dist/screen.js"
    }
  },
  "files": [
    "dist",
    "vendor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@podium/logger": "workspace:*",
    "@podium/model": "workspace:*",
    "@podium/protocol": "workspace:*",
    "@podium/runtime": "workspace:*"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "bun ../../scripts/typecheck-project.ts",
    "test": "bun ../../scripts/validation-admission.ts focused --label @podium/process:test -- bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "vitest": "5.0.0-beta.6"
  }
}
