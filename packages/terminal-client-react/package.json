{
  "name": "@podium/terminal-client-react",
  "version": "0.0.0",
  "private": true,
  "description": "React lifecycle binding over terminal DOM mounts and client-core transport.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@podium/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "bun ../../scripts/validation-admission.ts typecheck --label @podium/terminal-client-react:typecheck -- tsgo --noEmit",
    "typecheck:tsc": "bun ../../scripts/validation-admission.ts typecheck --label @podium/terminal-client-react:typecheck:tsc -- tsc --noEmit",
    "test": "bun ../../scripts/validation-admission.ts focused --label @podium/terminal-client-react:test -- bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@podium/client-core": "workspace:*",
    "@podium/model": "workspace:*",
    "@podium/terminal-client": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "5.0.0-beta.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@types/node": "^24.0.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
