{
  "name": "@podium/issue-client",
  "version": "0.0.0",
  "private": true,
  "description": "The issue-tracker client seam: the IssueTrpc client shape (HTTP tRPC + daemon relay transports) and the shared `podium issue` command table (names, zod arg shapes, positionals, client-side run/render bodies) consumed by the CLI and the server's in-process MCP.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "bun ../../scripts/validation-admission.ts typecheck --label @podium/issue-client:typecheck -- tsgo --noEmit",
    "typecheck:tsc": "bun ../../scripts/validation-admission.ts typecheck --label @podium/issue-client:typecheck:tsc -- tsc --noEmit",
    "test": "bun ../../scripts/validation-admission.ts focused --label @podium/issue-client:test -- bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@podium/commands": "workspace:*",
    "@podium/model": "workspace:*",
    "@podium/protocol": "workspace:*",
    "@trpc/client": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
