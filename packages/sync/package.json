{
  "name": "@podium/sync",
  "version": "0.0.0",
  "private": true,
  "description": "The node\u21c4hub sync layer: the metadata oplog (durable changes feed + outbox drain), the node\u2192hub dialer (UpstreamSync) and issue write forwarder (UpstreamForwarder), and the transcript-lake mirror (MirrorService). Depends only on @podium/protocol and @podium/runtime \u2014 never apps/*.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@podium/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@podium/commands": "workspace:*",
    "@podium/model": "workspace:*",
    "@podium/protocol": "workspace:*",
    "@podium/runtime": "workspace:*",
    "@trpc/client": "^11.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/ws": "^8.5.13",
    "vitest": "5.0.0-beta.6"
  }
}
