{
  "name": "@podium/sync",
  "version": "0.0.0",
  "private": true,
  "description": "The sync kernel: the Authority write funnel, the metadata oplog (durable changes feed + outbox drain), the Replica and Outbox roles, feed identity, the instantiation-parameterized conformance suite, and the transcript-lake mirror (MirrorService). Depends only on @podium/protocol and @podium/runtime — never apps/*.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@podium/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./replica": {
      "@podium/source": "./src/replica/index.ts",
      "types": "./src/replica/index.ts",
      "import": "./src/replica/index.ts"
    },
    "./outbox": {
      "@podium/source": "./src/outbox/index.ts",
      "types": "./src/outbox/index.ts",
      "import": "./src/outbox/index.ts"
    },
    "./span": {
      "@podium/source": "./src/span.ts",
      "types": "./src/span.ts",
      "import": "./src/span.ts"
    },
    "./adapters/indexeddb": {
      "@podium/source": "./src/adapters/indexeddb/index.ts",
      "types": "./src/adapters/indexeddb/index.ts",
      "import": "./src/adapters/indexeddb/index.ts"
    },
    "./adapters/legacy-replica": {
      "@podium/source": "./src/adapters/legacy-replica/index.ts",
      "types": "./src/adapters/legacy-replica/index.ts",
      "import": "./src/adapters/legacy-replica/index.ts"
    },
    "./adapters/mobile-sqlite": {
      "@podium/source": "./src/adapters/mobile-sqlite/index.ts",
      "types": "./src/adapters/mobile-sqlite/index.ts",
      "import": "./src/adapters/mobile-sqlite/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@podium/commands": "workspace:*",
    "@podium/model": "workspace:*",
    "@podium/protocol": "workspace:*",
    "@podium/runtime": "workspace:*",
    "@trpc/client": "^11.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^6.0.3",
    "vitest": "5.0.0-beta.6"
  }
}
