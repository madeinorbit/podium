    "/global/health": {
      "get": {
        "operationId": "global.health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Health information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "healthy": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "healthy",
                    "version"
                  ],
                  "additionalProperties": false,
                  "description": "Health information"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestError"
                }
              }
            }
          }
        }
      }
    }
  }
}