{
  "name": "@podium/harness",
  "version": "0.0.0",
  "private": true,
  "description": "Everything about agent harnesses in one package: per-CLI adapters, the driver contract + host, the transcript store, machine inventory and the browser descriptor surface.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@podium/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./metadata": {
      "@podium/source": "./src/metadata.ts",
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js"
    },
    "./browser": {
      "@podium/source": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./driver": {
      "@podium/source": "./src/driver.ts",
      "types": "./dist/driver.d.ts",
      "import": "./dist/driver.js"
    },
    "./driver/host": {
      "@podium/source": "./src/driver/host.ts",
      "types": "./dist/driver/host.d.ts",
      "import": "./dist/driver/host.js"
    },
    "./driver/testing": {
      "@podium/source": "./src/driver/testing/index.ts",
      "types": "./dist/driver/testing/index.d.ts",
      "import": "./dist/driver/testing/index.js"
    },
    "./store": {
      "@podium/source": "./src/store.ts",
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./inventory": {
      "@podium/source": "./src/inventory.ts",
      "types": "./dist/inventory.d.ts",
      "import": "./dist/inventory.js"
    },
    "./driver/families/terminal/composer-sync": {
      "@podium/source": "./src/driver/families/terminal/composer-sync.ts",
      "types": "./dist/driver/families/terminal/composer-sync.d.ts",
      "import": "./dist/driver/families/terminal/composer-sync.js"
    },
    "./driver/families/terminal/prompt-extract": {
      "@podium/source": "./src/driver/families/terminal/prompt-extract.ts",
      "types": "./dist/driver/families/terminal/prompt-extract.d.ts",
      "import": "./dist/driver/families/terminal/prompt-extract.js"
    },
    "./driver/families/terminal/instrumentation": {
      "@podium/source": "./src/driver/families/terminal/instrumentation.ts",
      "import": "./dist/driver/families/terminal/instrumentation.js",
      "types": "./dist/driver/families/terminal/instrumentation.d.ts"
    },
    "./driver/families/terminal/loopback-listen": {
      "@podium/source": "./src/driver/families/terminal/loopback-listen.ts",
      "import": "./dist/driver/families/terminal/loopback-listen.js",
      "types": "./dist/driver/families/terminal/loopback-listen.d.ts"
    },
    "./adapters/shared/hook-fields": {
      "@podium/source": "./src/adapters/shared/hook-fields.ts",
      "import": "./dist/adapters/shared/hook-fields.js",
      "types": "./dist/adapters/shared/hook-fields.d.ts"
    },
    "./adapters/claude-code/instrumentation": {
      "@podium/source": "./src/adapters/claude-code/instrumentation.ts",
      "import": "./dist/adapters/claude-code/instrumentation.js",
      "types": "./dist/adapters/claude-code/instrumentation.d.ts"
    },
    "./adapters/codex/instrumentation": {
      "@podium/source": "./src/adapters/codex/instrumentation.ts",
      "import": "./dist/adapters/codex/instrumentation.js",
      "types": "./dist/adapters/codex/instrumentation.d.ts"
    },
    "./adapters/grok/instrumentation": {
      "@podium/source": "./src/adapters/grok/instrumentation.ts",
      "import": "./dist/adapters/grok/instrumentation.js",
      "types": "./dist/adapters/grok/instrumentation.d.ts"
    },
    "./adapters/fixture": {
      "@podium/source": "./src/adapters/fixture/index.ts",
      "import": "./dist/adapters/fixture/index.js",
      "types": "./dist/adapters/fixture/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@podium/logger": "workspace:*",
    "@podium/model": "workspace:*",
    "@podium/protocol": "workspace:*",
    "@podium/runtime": "workspace:*",
    "zod": "^3.24.1"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "bun ../../scripts/typecheck-project.ts",
    "test": "bun ../../scripts/validation-admission.ts focused --label @podium/harness:test -- bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "tsup": "^8.5.1",
    "vitest": "5.0.0-beta.6",
    "ws": "^8.18.0"
  }
}
