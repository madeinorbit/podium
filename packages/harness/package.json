{
  "name": "@podium/harness",
  "version": "0.0.0",
  "private": true,
  "description": "Per-CLI agent manifests: one object per coding-agent CLI carrying launch/exec/headless/state/discovery/transcript. The single home for behavioral variance between Claude Code, Codex, Grok, OpenCode and Cursor.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@podium/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./metadata": {
      "@podium/source": "./src/metadata.ts",
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@podium/model": "workspace:*",
    "@podium/protocol": "workspace:*",
    "@podium/runtime": "workspace:*",
    "@podium/transcript": "workspace:*"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "bun ../../scripts/validation-admission.ts typecheck --label @podium/harness:typecheck -- tsgo --noEmit",
    "typecheck:tsc": "bun ../../scripts/validation-admission.ts typecheck --label @podium/harness:typecheck:tsc -- tsc --noEmit",
    "test": "bun ../../scripts/validation-admission.ts focused --label @podium/harness:test -- bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
