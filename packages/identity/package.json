{
  "name": "@podium/identity",
  "version": "0.0.0",
  "private": true,
  "description": "The shared identity package: accounts, password sign-in, device sign-ins, one-time codes and the capability list, with one implementation for the self-hosted server (SQLite) and the cloud (Postgres). Depends only on @podium/model \u2014 never apps/*.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@podium/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema/sqlite": {
      "@podium/source": "./src/schema/sqlite.ts",
      "types": "./src/schema/sqlite.ts",
      "import": "./src/schema/sqlite.ts"
    },
    "./schema/pg": {
      "@podium/source": "./src/schema/pg.ts",
      "types": "./src/schema/pg.ts",
      "import": "./src/schema/pg.ts"
    },
    "./testing": {
      "@podium/source": "./src/testing/index.ts",
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts"
    },
    "./upgrade": {
      "@podium/source": "./src/upgrade.ts",
      "types": "./src/upgrade.ts",
      "import": "./src/upgrade.ts"
    },
    "./library": {
      "@podium/source": "./src/library.ts",
      "types": "./src/library.ts",
      "import": "./src/library.ts"
    }
  },
  "scripts": {
    "typecheck": "bun ../../scripts/typecheck-project.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.4",
    "@better-auth/drizzle-adapter": "1.7.4",
    "@podium/model": "workspace:*",
    "better-auth": "1.7.4",
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "vitest": "5.0.0-beta.6"
  }
}
