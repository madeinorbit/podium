{
  "name": "@podium/agent-bridge",
  "version": "0.0.0",
  "private": true,
  "description": "Per-CLI harness adapters for the coding agents (Claude Code, Codex, Grok, Cursor, opencode): launch/exec/headless flags, agent-state classification, transcript location, discovery. The PTY half is @podium/pty.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@podium/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@podium/model": "workspace:*",
    "@podium/runtime": "workspace:*",
    "@podium/protocol": "workspace:*"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@podium/pty": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
