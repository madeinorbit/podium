{
  "name": "@podium/worklist-proto",
  "version": "0.0.0",
  "private": true,
  "description": "Round-two worklist prototypes (POD-4442): three independent first-principles implementations (hand-rolled, MobX, TanStack DB) of the frozen worklist slice, fed only by the kernel's per-row change stream. Greenfield: no imports from the legacy view-model, slice, mission or presentation code. Never imported by apps.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@podium/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./shared": {
      "@podium/source": "./shared/src/index.ts",
      "types": "./shared/src/index.ts",
      "import": "./shared/src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "bun ../../scripts/typecheck-project.ts",
    "test": "bun ../../scripts/validation-admission.ts focused --label @podium/worklist-proto:test -- bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts --passWithNoTests"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/eslint-parser": "7.29.9",
    "@babel/plugin-syntax-typescript": "7.27.1",
    "@playwright/test": "^1.60.0",
    "@podium/client-core": "workspace:*",
    "@podium/model": "workspace:*",
    "@podium/sync": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "eslint": "9.39.2",
    "eslint-plugin-mobx": "0.0.14",
    "happy-dom": "^20.10.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.86.0",
    "react-native-web": "0.21.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "5.0.0-beta.6"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "dependencies": {
    "mobx": "7.0.3",
    "mobx-react-lite": "5.0.3"
  }
}
